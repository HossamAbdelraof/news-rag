# Environment variables to add in Vercel (Project -> Settings -> Environment Variables).
# Every other setting already has the right default in src/helpers/config.py.

# Required
CHAT_API_KEY=                        # your OpenRouter key (also used for embeddings and reranking)
VECTOR_DB_PROVIDER=numpy             # read-only vectors exported to vectors/ (Chroma is not installed on Vercel)
VECTOR_DB_PATH=vectors

# Chat threads (optional: without it the app works, only saved threads are off).
# Paste the connection string from Neon / Supabase / Vercel Postgres, e.g.
# postgres://user:password@host/news_rag?sslmode=require
POSTGRES_URL=

# Optional
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# CHAT_MODEL_ID=google/gemma-4-26b-a4b-it
