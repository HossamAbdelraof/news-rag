# Copy to .env and add your OpenRouter key.
# To switch a model, comment one block and uncomment another.

APP_NAME=news-rag
APP_ENV=development
LOG_LEVEL=INFO

# ---- Embedding ----
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=                   
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MODEL_ID=qwen/qwen3-embedding-4b
EMBEDDING_QUERY_PREFIX="Instruct: Given a question about financial news, retrieve Reuters news articles that answer it\nQuery: "
EMBEDDING_DOCUMENT_PREFIX=""


# ---- Vector DB (Chroma in src/assets/database/chroma) ----
VECTOR_DB_PROVIDER=chroma            # chroma (read/write) | numpy (read-only export in vectors/, used on Vercel)
VECTOR_DB_PATH=chroma                # numpy: VECTOR_DB_PATH=vectors
VECTOR_DB_COLLECTION_PREFIX=news

# ---- Reranker ----
RERANKER_ENABLED=true
RERANKER_PROVIDER=openrouter         # openrouter (API, Arabic + English) | local (needs torch)
RERANKER_MODEL_ID=qwen/qwen3-reranker-8b
RERANKER_API_URL=https://openrouter.ai/api/v1
RERANKER_API_KEY=                    # empty = use CHAT_API_KEY

# Local reranker (GPU/CPU, needs torch + sentence-transformers)
# RERANKER_PROVIDER=local
# RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto                 # auto | cuda | cpu
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=16

# ---- Search ----
SEARCH_CANDIDATES=30                 # chunks sent to the reranker
SEARCH_TOP_K=5                       # results after reranking

# ---- Chunking (re-index with --reset after a change) ----
CHUNK_TOKENIZER_ID=BAAI/bge-reranker-v2-m3
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
CHUNK_MIN_TAIL_TOKENS=50

# ---- Chat model ----
CHAT_API_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=                     
CHAT_MODEL_ID=google/gemma-4-26b-a4b-it
# CHAT_MODEL_ID=google/gemma-4-31b-it

CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=350
CHAT_TOP_K=5
CHAT_CANDIDATES=30
CHAT_HISTORY_TURNS=4
CHAT_RELEVANCE_THRESHOLD=0.1
CHAT_GUARD_THRESHOLD=0.6

# ---- Langfuse (optional, empty = off) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Postgres (chat threads) ----
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=news_rag
